# ==============================================================================
# OBSERVATÓRIO DE VULNERABILIDADE SOCIOENERGÉTICA DE SALVADOR — SENAI CIMATEC
# Configuração de Ambiente (Frontend React + Vite & Pipeline ETL)
# ==============================================================================

# 1. Credenciais Públicas para o Frontend (Vite)
# ATENÇÃO DE SEGURANÇA: Utilize APENAS a chave pública `anon` no frontend,
# protegida por políticas de Row Level Security (RLS) de leitura no Supabase.
# NUNCA exponha a chave `service_role` em variáveis prefixadas com VITE_.
VITE_SUPABASE_URL=https://seu-projeto-id.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-jwt-aqui

# 2. Credenciais Exclusivas para o Pipeline ETL (Python Backend - NUNCA no Frontend)
SUPABASE_URL=https://seu-projeto-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-exclusiva-para-ingestao-etl
DATABASE_URL=postgresql://postgres:senha@db.seu-projeto-id.supabase.co:5432/postgres
